eval_gemfile("../Gemfile")

gem 'httpclient'
gem 'http'
gem 'redis'
gem 'moped'
gem 'actionpack'
gem 'actionview'
gem 'httpx'
gem 'grape'
# json 3.0 (released 2026-09) dropped the `quirks_mode` keyword that Grape 3's
# ActiveSupport JSON formatter still passes, so any Grape 3 JSON request raises
# ArgumentError. Pin to the 2.x line until this matrix moves off Grape 3.
gem 'json', '< 3'
